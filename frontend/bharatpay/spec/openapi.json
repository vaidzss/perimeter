          },
          "to_vpa": {
            "type": "string",
            "title": "To Vpa"
          },
          "amount_paise": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Paise",
            "description": "Amount in integer paise (e.g. 10000 = Rs 100)"
