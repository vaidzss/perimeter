{
  "openapi": "3.1.0",
  "info": {
    "title": "BharatPay Public Banking API",
    "description": "Documented production API surface for BharatPay neobank services.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v2/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login",
        "description": "Authenticate a user via email/phone and password, or test OTP stub ('123456').\nIssues a signed JWT access token containing sub, account_id, role, iat, exp, jti.",
        "operationId": "login_api_v2_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get Me",
        "description": "Returns current authenticated user profile.\nGuarantees all PII is synthetic and PAN/Aadhaar are masked.",
        "operationId": "get_me_api_v2_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/accounts/{account_id}/statement": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get Account Statement",
        "description": "Fetch account statement including balance, masked identifiers, KYC status, and last 10 transactions.\nSECURITY CONTROL: Enforces strict ownership. Returning 403 Forbidden for any other user's account ID.",
        "operationId": "get_account_statement_api_v2_accounts__account_id__statement_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Account Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/upi/merchants": {
      "get": {
        "tags": [
          "Merchants"
        ],
        "summary": "List Merchants",
        "description": "Paginated directory of verified UPI merchants.\nSupports filtering and full text searching.",
        "operationId": "list_merchants_api_v2_upi_merchants_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Limit"
            },
            "description": "Items per page"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Search by merchant name or category",
              "title": "Search"
            },
            "description": "Search by merchant name or category"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedMerchantsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/payments/upi-transfer": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Execute Upi Transfer",
        "description": "Execute a peer-to-peer or peer-to-merchant UPI transfer.\nEnforces idempotency, sufficient funds, and daily transfer limit.\nAll currency is handled strictly in integer paise.",
        "operationId": "execute_upi_transfer_api_v2_payments_upi_transfer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UPITransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UPITransferResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/internal/reports/regional-sales": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Regional Sales & Turnover Report",
        "description": "Sales Manager+ endpoint for regional sales metrics. Enforces assigned regional jurisdiction server-side.",
        "operationId": "get_regional_sales_report",
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "West"
            },
            "description": "Target region (West, North, South, East)"
          },
          {
            "name": "date_range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "30d"
            },
            "description": "Time window"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Scope or role violation"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/internal/reports/account-lookup/{account_id}": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Internal Support Account Lookup",
        "description": "Customer support escalation account query. Requires mandatory business reason and enforces regional jurisdiction.",
        "operationId": "lookup_account_internal",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Mandatory business justification / dispute ticket #"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Missing mandatory reason"
          },
          "403": {
            "description": "Cross-regional scope violation"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/internal/reports/org-wide-summary": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Org-Wide Executive Liquidity Summary",
        "description": "Executive reporting endpoint strictly restricted to VP Sales. Provides bank-wide KPIs and regional liquidity.",
        "operationId": "get_org_wide_summary_internal",
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Restricted to VP Sales"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/internal/reports/bulk-export": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Bulk Export Operational Data",
        "description": "Privileged bulk export for Regional Head+ roles with reason auditing and scope verification.",
        "operationId": "bulk_export_reports_internal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "region": {
                    "type": "string"
                  },
                  "export_format": {
                    "type": "string",
                    "default": "json"
                  },
                  "include_transactions": {
                    "type": "boolean",
                    "default": true
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Role or scope forbidden"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/internal/employees/onboard": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Employee Provisioning & Scoped Token Issuance",
        "description": "IT Admin onboarding endpoint granting bounded default role scope or explicit access grants.",
        "operationId": "onboard_employee_internal",
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Privilege escalation rejected"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/internal/campaigns": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Register Sanctioned Business Campaign Window",
        "description": "Registers sanctioned high-traffic campaign event informing detection engine of expected traffic multipliers.",
        "operationId": "create_campaign_internal",
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Unauthorized role"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/internal/employees/{id}/access-log": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Employee Telemetry Audit Trail",
        "description": "Audit log of actions performed by employee identity.",
        "operationId": "get_employee_access_log_internal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
